diff --git a/Sources/TiriCore/WorkingDuration.swift b/Sources/TiriCore/WorkingDuration.swift
new file mode 100644
index 0000000..df77395
--- /dev/null
+++ b/Sources/TiriCore/WorkingDuration.swift
@@ -0,0 +1,11 @@
+import Foundation
+
+/// How long an agent has been working, in the fewest words: "12s", "4m 05s", "1h 02m".
+public enum WorkingDuration {
+    public static func text(_ seconds: TimeInterval) -> String {
+        let total = max(0, Int(seconds))
+        if total < 60 { return "\(total)s" }
+        if total < 3600 { return "\(total / 60)m \(String(format: "%02d", total % 60))s" }
+        return "\(total / 3600)h \(String(format: "%02d", (total % 3600) / 60))m"
+    }
+}
